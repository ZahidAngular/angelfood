# Copy to .env.local and fill in. Everything prefixed NEXT_PUBLIC_ is compiled
# into the JavaScript every visitor downloads — never put a secret in one.

# Angel Food API. Defaults to the production API when unset.
NEXT_PUBLIC_API_BASE_URL=https://angelfood-api.webappconsulting.com.au/api

# Canonical site origin, used for metadata, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.angelfood.co.nz

# The endpoint that creates a Stripe Checkout Session. Until this is set, the
# checkout page says payments aren't connected and paying fails with a clear
# message. See docs/stripe-checkout.md.
NEXT_PUBLIC_CHECKOUT_API_URL=

# The Stripe SECRET key belongs in the environment of whatever serves the
# endpoint above — never here, and never in a NEXT_PUBLIC_ variable.
